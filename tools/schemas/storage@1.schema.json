{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vn:schemas/storage@1",
  "title": "storage@1 — логические хранилища сырцов (.vnstorage.yaml, G21): file (папка/NAS) или s3",
  "type": "object",
  "properties": {
    "schema": {"const": "storage@1"},
    "storages": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {"const": "file"},
              "path": {"type": "string", "minLength": 1}
            },
            "required": ["type", "path"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {"const": "s3"},
              "endpoint": {"type": "string", "format": "uri"},
              "bucket": {"type": "string", "minLength": 1}
            },
            "required": ["type", "endpoint", "bucket"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["schema", "storages"],
  "additionalProperties": false
}
