{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vn:schemas/gen_manifest@1",
  "title": "gen_manifest@1 — манифест Content Compiler ДО поля source (историческая версия): остаётся в реестре, потому что артефакты CI живут 30 дней и несут этот тег",
  "type": "object",
  "$defs": {
    "hash_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{16,64}$"
      }
    }
  },
  "properties": {
    "schema": {
      "const": "gen_manifest@1"
    },
    "tool": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "inputs": {
      "$ref": "#/$defs/hash_map"
    },
    "outputs": {
      "$ref": "#/$defs/hash_map"
    }
  },
  "required": [
    "schema",
    "tool",
    "inputs",
    "outputs"
  ],
  "additionalProperties": false
}
