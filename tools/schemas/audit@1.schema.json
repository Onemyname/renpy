{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vn:schemas/audit@1",
  "title": "audit@1 — трассировка пунктов аудита (docs/audit/*.audit.yaml)",
  "description": "Машиночитаемый статус аудита: пункт -> доказательство в коде -> реализация -> тесты -> статус. Существует, чтобы «аудит закрыт» означало проверяемый факт, а не написанный отчёт: каждый CLOSED обязан называть файл реализации и тест, а WONT_FIX — техническое обоснование.",
  "type": "object",
  "properties": {
    "schema": {"const": "audit@1"},
    "source": {"type": "string", "minLength": 1, "description": "Документ-первоисточник аудита"},
    "reviewed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "items": {
      "type": "object",
      "propertyNames": {"pattern": "^AUDIT-\\d{3}$"},
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "category": {
            "enum": ["correctness", "architecture", "content-pipeline", "runtime",
                     "quality-gate", "scalability", "dx", "documentation"]
          },
          "evidence": {
            "type": "array", "minItems": 1, "items": {"type": "string"},
            "description": "Где проблема была видна в коде на момент аудита"
          },
          "implementation": {
            "type": "array", "items": {"type": "string"},
            "description": "Файлы, в которых сделано исправление"
          },
          "tests": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["OPEN", "IN_PROGRESS", "CLOSED", "WONT_FIX", "DUPLICATE"]},
          "duplicate_of": {"type": "string", "pattern": "^AUDIT-\\d{3}$"},
          "rationale": {"type": "string", "description": "Обязателен для WONT_FIX"},
          "note": {"type": "string"}
        },
        "required": ["title", "category", "evidence", "status"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "CLOSED"}}, "required": ["status"]},
            "then": {"required": ["implementation", "tests"]}
          },
          {
            "if": {"properties": {"status": {"const": "WONT_FIX"}}, "required": ["status"]},
            "then": {"required": ["rationale"]}
          },
          {
            "if": {"properties": {"status": {"const": "DUPLICATE"}}, "required": ["status"]},
            "then": {"required": ["duplicate_of"]}
          }
        ]
      }
    }
  },
  "required": ["schema", "source", "items"],
  "additionalProperties": false
}
