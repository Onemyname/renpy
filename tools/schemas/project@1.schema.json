{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vn:schemas/project@1",
  "title": "project@1 — корневой манифест проекта (project.yaml)",
  "type": "object",
  "properties": {
    "schema": {"const": "project@1"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "save_schema": {"type": "integer", "minimum": 1},
    "min_tools": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "renpy_sdk": {
      "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Пиннованная версия Ren'Py SDK (G18); vn doctor сверяет с RENPY_SDK"
    },
    "budgets": {
      "type": "object",
      "description": "Перф/размер-бюджеты (G19): превышение = ошибка vn build",
      "properties": {
        "assets_total_mb": {"type": "number", "minimum": 0},
        "generated_total_kb": {"type": "number", "minimum": 0},
        "cold_start_s": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "required": ["schema", "version", "save_schema", "min_tools"],
  "additionalProperties": false
}
