{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vn:schemas/project@1",
  "title": "project@1 — корневой манифест проекта (project.yaml)",
  "type": "object",
  "properties": {
    "schema": {"const": "project@1"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "save_schema": {"type": "integer", "minimum": 1},
    "min_tools": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "renpy_sdk": {
      "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Пиннованная версия Ren'Py SDK (G18); vn doctor сверяет с RENPY_SDK"
    },
    "budgets": {
      "type": "object",
      "description": "Перф/размер-бюджеты (G19): превышение = ошибка vn build",
      "properties": {
        "assets_total_mb": {"type": "number", "minimum": 0},
        "generated_total_kb": {"type": "number", "minimum": 0},
        "cold_start_s": {"type": "number", "minimum": 0},
        "video_total_mb": {"type": "number", "minimum": 0, "description": "Суммарный бюджет game/assets/mov (ADR-0006)"},
        "video_file_mb": {"type": "number", "minimum": 0, "description": "Бюджет одного видео-файла (ADR-0006)"}
      },
      "additionalProperties": false
    },
    "flavors": {
      "type": "object",
      "description": "Релизные флейворы (ADR-0006): vn release build --flavor <id>",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "object",
          "properties": {
            "packs": {
              "type": "array",
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"},
              "description": "Паки, чьи депот-артефакты входят в поставку флейвора (скрипты грузятся всегда — гейт логический, G9)"
            },
            "nsfw": {"type": "boolean", "description": "false = поддеревья assets/*/nsfw/** исключаются из дистрибутива"},
            "early_content": {"type": "boolean", "description": "Ранний доступ: рантайм-гейт vn_build.early_content"},
            "watermark": {"type": "boolean", "description": "Полупрозрачный build-id поверх игры (трассировка утечек patron-сборок)"}
          },
          "required": ["packs", "nsfw"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["schema", "version", "save_schema", "min_tools"],
  "additionalProperties": false
}
