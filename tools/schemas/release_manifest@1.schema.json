{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vn:schemas/release_manifest@1",
  "title": "release_manifest@1 — снимок контента релиза (ci/release-manifest.json): база диффа для changelog и переиздания переводов",
  "type": "object",
  "properties": {
    "schema": {"const": "release_manifest@1"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "chapters": {
      "type": "object",
      "propertyNames": {"pattern": "^ch\\d{2}$"},
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {"enum": ["draft", "playtest", "release"]},
          "scenes": {"type": "array", "items": {"type": "string", "pattern": "^ch\\d{2}_s\\d{3}$"}},
          "pack": {"type": "string", "pattern": "^(core|[a-z][a-z0-9_]{1,31})$", "description": "Пак-владелец главы по её расположению (C10): core = content/chapters, иначе packs/<id>/chapters. Нужен в снимке, чтобы changelog отличал контент, который уедет не всем"}
        },
        "required": ["status", "scenes", "pack"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "version", "chapters"],
  "additionalProperties": false
}
