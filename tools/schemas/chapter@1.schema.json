{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vn:schemas/chapter@1",
  "title": "chapter@1 — метаданные главы (chapter.yaml)",
  "type": "object",
  "properties": {
    "schema": {"const": "chapter@1"},
    "id": {"type": "string", "pattern": "^ch\\d{2}$"},
    "title_key": {"type": "string", "pattern": "^[a-z0-9_.]+$"},
    "status": {"enum": ["draft", "playtest", "release"]},
    "owner": {"type": "string", "pattern": "^@[A-Za-z0-9_-]+$"},
    "entry_scene": {"type": "string", "pattern": "^s\\d{3}$"},
    "scene_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^s\\d{3}$"}
    },
    "endings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Сцены-концовки: легитимные тупики (нет exits). Последняя сцена scene_order считается концовкой и без объявления; перечислять нужно остальные — иначе глава со взаимоисключающими финалами невозможна. Флоучарт помечает эти узлы отдельно (ADR-0021)",
      "items": {"type": "string", "pattern": "^s\\d{3}$"}
    },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "description": "Фазы главы для флоучарта (ADR-0021): только ГРУППИРОВКА узлов, не геометрия — раскладка остаётся автоматической. Сцена может не входить ни в один кластер",
      "items": {
        "type": "object",
        "properties": {
          "title_key": {"type": "string", "pattern": "^[a-z0-9_.]+$"},
          "scenes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^s\\d{3}$"}
          }
        },
        "required": ["title_key", "scenes"],
        "additionalProperties": false
      }
    },
    "requires": {
      "type": "object",
      "properties": {
        "systems": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "chapters": {"type": "array", "items": {"type": "string", "pattern": "^ch\\d{2}$"}}
      },
      "additionalProperties": false
    }
  },
  "required": ["schema", "id", "title_key", "status", "entry_scene", "scene_order"],
  "additionalProperties": false
}
