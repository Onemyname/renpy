{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vn:schemas/location@1",
  "title": "location@1 — декларация локации (content/locations/<id>/location.yaml)",
  "type": "object",
  "properties": {
    "schema": {"const": "location@1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "title_key": {"type": "string", "pattern": "^[a-z0-9_.]+$"},
    "backgrounds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string", "pattern": "^assets/bg/[a-z0-9_/]+\\.webp$"},
      "description": "Вариант (day/evening/night/…) → файл"
    },
    "lighting": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "description": "Вариант → тонировочный профиль (matrixcolor-профили — раздел 4)"
    }
  },
  "required": ["schema", "id", "backgrounds"],
  "additionalProperties": false
}
