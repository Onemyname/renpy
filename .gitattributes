# LFS — ТОЛЬКО немногие коммитящиеся бинари (раздел 1.1 ARCHITECTURE.md).
# Game-ready ассеты не коммитятся вовсе (vn bootstrap), сырцы живут в S3 через манифесты.
*.ttf  filter=lfs diff=lfs merge=lfs -text
*.otf  filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
docs/**/*.png  filter=lfs diff=lfs merge=lfs -text
docs/**/*.jpg  filter=lfs diff=lfs merge=lfs -text

# Нормализация переводов строк
* text=auto eol=lf
*.rpy text eol=lf
*.py  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cmd text eol=crlf
