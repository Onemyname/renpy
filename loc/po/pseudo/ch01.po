#. говорит: рассказчик; сцена ch01_s010
msgctxt "ch01_s010_0001"
msgid ""
"Первый учебный день. Звонок уже прозвенел, а ты всё ещё стоишь у ворот."
msgstr ""
"[[Пęрвый ųчęбный дęнь. Звǫнǫк ųжę прǫзвęнęл, ą ты всё ęщё стǫįшь ų "
"вǫрǫт.~~~~~~~~~~~~~~~~~~~~~~~~~~~~]"

#. говорит: рассказчик; сцена ch01_s010
msgctxt "ch01_s010_0002"
msgid "У ворот кто-то есть."
msgstr "[[Ų вǫрǫт ктǫ-тǫ ęсть.~~~~~~~~]"

#. говорит: mira; сцена ch01_s020
msgctxt "ch01_s020_0001"
msgid "Ты опять проспал?"
msgstr "[[Ты ǫпять прǫспąл?~~~~~~]"

#. говорит: mira; сцена ch01_s020
msgctxt "ch01_s020_0002"
msgid "Ну-ну. Очень убедительно."
msgstr "[[Нų-нų. Ǫчęнь ųбęдįтęльнǫ.~~~~~~~~~~]"

#. говорит: mira; сцена ch01_s020
msgctxt "ch01_s020_0003"
msgid "Хотя бы честно. Пойдём, провожу до крыши."
msgstr "[[Хǫтя бы чęстнǫ. Пǫйдём, прǫвǫжų дǫ крышį.~~~~~~~~~~~~~~~~]"

#. говорит: mira; сцена ch01_s020
msgctxt "ch01_s020_0004"
msgid "Ладно. Беги, звонок уже был."
msgstr "[[Лąднǫ. Бęгį, звǫнǫк ųжę был.~~~~~~~~~~~]"

#. говорит: рассказчик; сцена ch01_s030
msgctxt "ch01_s030_0001"
msgid "Крыша. Ветер. Город до горизонта."
msgstr "[[Крышą. Вęтęр. Гǫрǫд дǫ гǫрįзǫнтą.~~~~~~~~~~~~~]"

#. говорит: mira; сцена ch01_s030
msgctxt "ch01_s030_0002"
msgid "А ты быстрее, чем кажешься."
msgstr "[[Ą ты быстрęę, чęм кąжęшься.~~~~~~~~~~]"

#. говорит: рассказчик; сцена ch01_s030
msgctxt "ch01_s030_0003"
msgid "Она смеётся. Кажется, этот год будет интересным."
msgstr ""
"[[Ǫнą смęётся. Кąжęтся, этǫт гǫд бųдęт įнтęрęсным.~~~~~~~~~~~~~~~~~~~]"

#. говорит: рассказчик; сцена ch01_s030
msgctxt "ch01_s030_0004"
msgid "Ты здесь один. Тихо. Слишком тихо."
msgstr "[[Ты здęсь ǫдįн. Тįхǫ. Слįшкǫм тįхǫ.~~~~~~~~~~~~~]"

#. говорит: рассказчик; сцена ch01_s030
msgctxt "ch01_s030_0005"
msgid "КОНЕЦ ДЕМО-ГЛАВЫ"
msgstr "[[КǪНĘЦ ДĘМǪ-ГЛĄВЫ~~~~~~]"

#. говорит: рассказчик; сцена ch01_s030
msgctxt "ch01_s030_0006"
msgid "Город лежит внизу, будто выдохнул."
msgstr "[[Гǫрǫд лęжįт внįзų, бųдтǫ выдǫхнųл.~~~~~~~~~~~~~]"

#. говорит: рассказчик; сцена ch01_s030
msgctxt "ch01_s030_0007"
msgid "Закат раскрашивает крышу заново."
msgstr "[[Зąкąт рąскрąшįвąęт крышų зąнǫвǫ.~~~~~~~~~~~~]"

#. говорит: рассказчик; сцена ch01_s030
msgctxt "ch01_s030_0008"
msgid "Мира успела переодеться — кадр это уже знает."
msgstr "[[Мįрą ųспęлą пęрęǫдęться — кąдр этǫ ųжę знąęт.~~~~~~~~~~~~~~~~~~]"

#. пункт меню 0; сцена ch01_s010
msgctxt "ch01_s010_m001[0]"
msgid "Подойти к воротам"
msgstr "[[Пǫдǫйтį к вǫрǫтąм~~~~~~]"

#. пункт меню 1; сцена ch01_s010
msgctxt "ch01_s010_m001[1]"
msgid "Подняться сразу на крышу"
msgstr "[[Пǫдняться срąзų нą крышų~~~~~~~~~]"

#. пункт меню 0; сцена ch01_s020
msgctxt "ch01_s020_m001[0]"
msgid "Соврать"
msgstr "[[Сǫврąть~~]"

#. пункт меню 1; сцена ch01_s020
msgctxt "ch01_s020_m001[1]"
msgid "Сказать правду"
msgstr "[[Скąзąть прąвдų~~~~~]"
