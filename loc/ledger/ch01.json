{
 "chapter": "ch01",
 "menus": {
  "ch01_s010_m001": {
   "items": [
    "Подойти к воротам",
    "Подняться сразу на крышу"
   ]
  },
  "ch01_s020_m001": {
   "items": [
    "Соврать",
    "Сказать правду"
   ]
  }
 },
 "says": {
  "ch01_s010_0001": {
   "text": "Первый учебный день. Звонок уже прозвенел, а ты всё ещё стоишь у ворот.",
   "who": null
  },
  "ch01_s010_0002": {
   "text": "У ворот кто-то есть.",
   "who": null
  },
  "ch01_s020_0001": {
   "text": "Ты опять проспал?",
   "who": "mira"
  },
  "ch01_s020_0002": {
   "text": "Ну-ну. Очень убедительно.",
   "who": "mira"
  },
  "ch01_s020_0003": {
   "text": "Хотя бы честно. Пойдём, провожу до крыши.",
   "who": "mira"
  },
  "ch01_s020_0004": {
   "text": "Ладно. Беги, звонок уже был.",
   "who": "mira"
  },
  "ch01_s030_0001": {
   "text": "Крыша. Ветер. Город до горизонта.",
   "who": null
  },
  "ch01_s030_0002": {
   "text": "А ты быстрее, чем кажешься.",
   "who": "mira"
  },
  "ch01_s030_0003": {
   "text": "Она смеётся. Кажется, этот год будет интересным.",
   "who": null
  },
  "ch01_s030_0004": {
   "text": "Ты здесь один. Тихо. Слишком тихо.",
   "who": null
  },
  "ch01_s030_0005": {
   "text": "КОНЕЦ ДЕМО-ГЛАВЫ",
   "who": null
  },
  "ch01_s030_0006": {
   "text": "Город лежит внизу, будто выдохнул.",
   "who": null
  },
  "ch01_s030_0007": {
   "text": "Закат раскрашивает крышу заново.",
   "who": null
  },
  "ch01_s030_0008": {
   "text": "Мира успела переодеться — кадр это уже знает.",
   "who": null
  }
 },
 "schema": "ledger@1"
}
